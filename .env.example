# Fill in and export before `dotnet run`, e.g. `set -a; source .env; set +a` (a copy named .env is gitignored). Cloud agent environments set these as environment variables instead.
# Alpaca market data, free plan: https://alpaca.markets/
ALPACA_KEY=
ALPACA_SECRET=
ALPACA_PAPER_TRADE=true
ALPACA_TOOLSETS=all

# ALPACA MCP SERVER EXAMPLE
# ref: https://docs.alpaca.markets/us/docs/trading-api-mcp.md
#
# claude mcp add alpaca --scope user --transport stdio uvx alpaca-mcp-server \
#   --env ALPACA_API_KEY=$ALPACA_KEY \
#   --env ALPACA_SECRET_KEY=$ALPACA_SECRET \
#   --env ALPACA_PAPER_TRADE=true \
#   --env ALPACA_TOOLSETS=all
#
