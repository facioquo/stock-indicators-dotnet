# Copy to .env (gitignored) and fill in. Cloud agent environments set these as environment variables instead.
# Alpaca market data, free plan: https://alpaca.markets/
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER_TRADE=true
ALPACA_TOOLSETS=all

