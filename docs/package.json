{
  "name": "stock-indicators-docs",
  "version": "1.0.0",
  "description": "Stock Indicators for .NET documentation",
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "clean": "rm -rf node_modules dist .vitepress/dist .vitepress/cache _site && rm -f pnpm-lock.yaml package-lock.json yarn.lock",
    "docs:dev": "vitepress dev",
    "docs:build": "vitepress build",
    "docs:preview": "vitepress preview",
    "test": "playwright test",
    "test:charts": "playwright test --project=charts",
    "test:a11y": "playwright test --project=a11y --project=analytics",
    "test:links": "bash .vitepress/test-links.sh"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@octokit/rest": "^22.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26",
    "sass-embedded": "^1.104.1",
    "vitepress": "2.0.0-alpha.20",
    "vitepress-plugin-llms": "1.14.0",
    "vue": "^3.5.42"
  },
  "dependencies": {
    "@facioquo/indy-charts": "^0.10.0",
    "chart.js": "^4.5.1",
    "chartjs-plugin-annotation": "^3.1.0"
  }
}
