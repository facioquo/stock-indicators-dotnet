{
  "name": "stock-indicators-docs",
  "version": "1.0.0",
  "description": "Stock Indicators for .NET documentation",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "cleanup": "pnpm clean && rm -rf dist .vitepress/dist .vitepress/cache _site && rm -f pnpm-lock.yaml package-lock.json yarn.lock",
    "docs:dev": "vitepress dev",
    "docs:build": "vitepress build",
    "docs:preview": "vitepress preview",
    "snapshot:charts": "node .vitepress/snapshot-charts.ts",
    "test": "playwright test",
    "test:charts": "playwright test --project=charts",
    "test:offline": "playwright test --project=offline",
    "test:a11y": "playwright test --project=a11y --project=analytics",
    "test:agents": "playwright test --project=agent-features",
    "test:layout": "playwright test --project=layout",
    "test:parity": "PARITY_ONLY=1 playwright test --project=parity",
    "test:links": "bash .vitepress/test-links.sh"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@octokit/rest": "^22.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26",
    "sass-embedded": "^1.106.1",
    "vitepress": "2.0.0-alpha.20",
    "vitepress-plugin-llms": "1.14.0",
    "vue": "^3.5.44",
    "wrangler": "^4.153.0"
  },
  "dependencies": {
    "@facioquo/indy-charts": "^0.18.1",
    "chart.js": "^4.6.1",
    "chartjs-plugin-annotation": "^3.1.0"
  }
}
